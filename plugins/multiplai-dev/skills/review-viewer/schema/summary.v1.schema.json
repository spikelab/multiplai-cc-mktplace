{
  "$defs": {
    "RiskInput": {
      "additionalProperties": false,
      "description": "The session's two judgments the risk score needs; the page applies the\nrules (see logic.js riskLevel). `tier` is how critical the most critical\nchanged code is, from the table in SKILL.md: 0 docs, tests and tooling;\n1 one feature; 2 a shared module or public interface; 3 auth, money, data\ndeletion or migration, shared infra, production deploy config. A repo's\n`.review-risk.toml`, read at the base commit, can raise it for the files\nit matches, never lower it.",
      "properties": {
        "revert_why": {
          "minLength": 1,
          "title": "Revert Why",
          "type": "string"
        },
        "revertable": {
          "title": "Revertable",
          "type": "boolean"
        },
        "tier": {
          "maximum": 3,
          "minimum": 0,
          "title": "Tier",
          "type": "integer"
        },
        "tier_why": {
          "minLength": 1,
          "title": "Tier Why",
          "type": "string"
        }
      },
      "required": [
        "tier",
        "tier_why",
        "revertable",
        "revert_why"
      ],
      "title": "RiskInput",
      "type": "object"
    },
    "SummaryAssessment": {
      "additionalProperties": false,
      "description": "The session's judgment on one quality question, shown as a badge beside\nthe measured ones. `commits` (does anything say why the change is made?)\nand `tests` (would a test fail if the changed behaviour broke?) are\nrequired once the summary is complete, and judged by the rubric in\nSKILL.md. `size` and `risk` are accepted in files written before 0.22 but\nrejected by `summary put`: size is measured and risk is the header\nscore.",
      "properties": {
        "detail_md": {
          "title": "Detail Md",
          "type": "string"
        },
        "title": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "topic": {
          "enum": [
            "commits",
            "tests",
            "size",
            "design",
            "risk",
            "other"
          ],
          "title": "Topic",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "good",
            "note",
            "concern"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "verdict",
        "title",
        "detail_md"
      ],
      "title": "SummaryAssessment",
      "type": "object"
    }
  },
  "$id": "summary.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessments": {
      "items": {
        "$ref": "#/$defs/SummaryAssessment"
      },
      "title": "Assessments",
      "type": "array"
    },
    "base_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Base Sha",
      "type": "string"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Head Sha",
      "type": "string"
    },
    "risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "base_sha",
    "head_sha",
    "complete"
  ],
  "title": "Summary",
  "type": "object"
}
