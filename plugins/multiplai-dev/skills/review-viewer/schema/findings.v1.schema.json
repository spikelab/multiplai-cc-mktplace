{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "description": "The review's own judgement of a finding against the rest of the review\nand earlier rounds (multiplai-dev 0.27+). Older files have none.\n\n`repeat`: the same defect as a finding the person rejected in an earlier\nround (`earlier_*` say which, with the decision and note). `still-open`:\nthe same defect as an earlier finding that was accepted or not decided.\n`low-value`: true, but not worth acting on, for the reason given.\n`useful`: everything else. A label never removes a finding.",
      "properties": {
        "earlier_decision": {
          "anyOf": [
            {
              "enum": [
                "accept",
                "reject",
                "defer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earlier Decision"
        },
        "earlier_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earlier Id"
        },
        "earlier_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earlier Note"
        },
        "earlier_round": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earlier Round"
        },
        "label": {
          "enum": [
            "useful",
            "still-open",
            "low-value",
            "repeat"
          ],
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line_start",
        "line_end",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Assessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "expected_behaviour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Behaviour"
        },
        "failure_scenario": {
          "title": "Failure Scenario",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fix"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[0-9a-f]{10}$",
          "title": "Id",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "unverifiable",
            "refuted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "verdict_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict Reason"
        },
        "verifier_citations": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Citation"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifier Citations"
        }
      },
      "required": [
        "id",
        "severity",
        "status",
        "claim",
        "file",
        "line_start",
        "line_end",
        "failure_scenario",
        "citations"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Fix": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "patch_sketch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Sketch"
        },
        "premises": {
          "items": {
            "$ref": "#/$defs/Premise"
          },
          "title": "Premises",
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "Fix",
      "type": "object"
    },
    "Premise": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "in_repo",
            "external"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "kind"
      ],
      "title": "Premise",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "files_changed": {
          "items": {
            "type": "string"
          },
          "title": "Files Changed",
          "type": "array"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "remote_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Url"
        },
        "repo_path": {
          "title": "Repo Path",
          "type": "string"
        },
        "slug": {
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "label",
        "repo_path",
        "base_sha",
        "head_sha",
        "files_changed"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "$id": "findings.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target": {
      "$ref": "#/$defs/Target"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "producer",
    "target",
    "findings"
  ],
  "title": "FindingsFile",
  "type": "object"
}
